<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Empty on purpose.

	     App Groups needs a paid Apple Developer account. On a free personal team
	     Xcode cannot register the group and signing fails, so the entitlement is
	     left out and the code falls back to per-app storage.

	     To turn it back on with a paid account, add to all three of these files:

	         <key>com.apple.security.application-groups</key>
	         <array>
	             <string>group.com.cashmemer.shared</string>
	         </array>

	     That restores the shared Core Data store, so the widget and the watch app
	     can read the phone's receipts. Firestore sync does not depend on it. -->
</dict>
</plist>
